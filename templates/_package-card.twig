<article class="package-card">
    <div class="package-card-meta">
        <a href="{{ package.repository }}">{{ package.name }}</a>
    </div>
    <p>{{ package.description }}</p>
    <div class="package-card-footer">
        <span>v{{ package.version }}</span>
        <div class="package-card-links">
            <a href="{{ package.repository }}">{{ locale == 'fr' ? 'Dépôt' : 'Repository' }} <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</article>
