{% extends 'layout.twig' %}

{% block title %}Silex — {{ locale == 'fr' ? 'Code moderne. Puissance native.' : 'Modern Code. Native Power.' }}{% endblock %}

{% block content %}
<section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
        <div class="hero-meta">
            <p class="eyebrow">{{ locale == 'fr' ? 'Langage natif moderne' : 'Modern native language' }}</p>
            <a class="version-badge" href="{{ silex_version == 'development' ? 'https://github.com/Matanek/Silex/releases' : 'https://github.com/Matanek/Silex/releases/tag/v' ~ silex_version }}">
                {{ locale == 'fr' ? 'Version Silex' : 'Silex release' }} <strong>{{ silex_version == 'development' ? 'dev' : 'v' ~ silex_version }}</strong>
            </a>
        </div>
        <h1 id="hero-title"><span>{{ locale == 'fr' ? 'Code moderne' : 'Modern Code' }}</span><span>{{ locale == 'fr' ? 'Puissance native' : 'Native Power' }}</span></h1>
        <p class="lede">{{ locale == 'fr' ? 'Silex est un langage et un compilateur natif expérimental, avec des modules, des packages et une toolchain intégrée.' : 'Silex is an experimental native language and compiler, with modules, packages and an integrated toolchain.' }}</p>
        <div class="actions">
            <a class="button button-primary" href="#install">{{ locale == 'fr' ? 'Installer Silex' : 'Install Silex' }}</a>
            <a class="button button-secondary" href="/{{ locale }}/docs">{{ locale == 'fr' ? 'Lire la documentation' : 'Read the docs' }}</a>
        </div>
    </div>

    <div class="code-window" aria-label="{{ locale == 'fr' ? 'Exemple de code Silex' : 'Silex code example' }}">
        <div class="code-titlebar"><span></span><span></span><span></span><strong>Main.sx</strong></div>
        <pre><code><span class="keyword">func</span> answer() <span class="type">int</span> {
    <span class="keyword">return</span> 40 + 2
}

<span class="keyword">func</span> main() {
    print(answer())
}</code></pre>
        <div class="terminal-line"><span>$</span> silex run Main.sx <strong>→ 42</strong></div>
    </div>
</section>

{% set principles = locale == 'fr' ? [
    ['01', 'Simple', 'Un langage ciblé et une toolchain intégrée rendent l’écriture, la compilation et l’exécution directes.'],
    ['02', 'Sémantique explicite', 'Valeurs, références et déplacements expriment clairement la manière dont les données circulent.'],
    ['03', 'Exécutables natifs', 'Le compilateur produit directement des exécutables natifs pour les plateformes prises en charge.']
] : [
    ['01', 'Simple', 'A focused language and integrated toolchain keep writing, building and running programs direct.'],
    ['02', 'Explicit semantics', 'Values, references and moves make the way data flows through a program clear.'],
    ['03', 'Native executables', 'The compiler directly produces native executables for its supported targets.']
] %}
<section class="principles" aria-label="{{ locale == 'fr' ? 'Principes de Silex' : 'Silex principles' }}">
    {% for principle in principles %}
        <article>
            <span class="number">{{ principle[0] }}</span>
            <h2>{{ principle[1] }}</h2>
            <p>{{ principle[2] }}</p>
        </article>
    {% endfor %}
</section>

<section class="section install" id="install" aria-labelledby="install-title">
    <div class="section-heading">
        <p class="eyebrow">{{ locale == 'fr' ? 'Commencer ici' : 'Start here' }}</p>
        <h2 id="install-title">{{ locale == 'fr' ? 'Installer Silex' : 'Install Silex' }}</h2>
        <p>{{ locale == 'fr' ? 'Le compilateur autonome ne demande ni Zig, ni Git sur la machine du développeur.' : 'The standalone compiler does not require Zig or Git on the developer machine.' }}</p>
    </div>

    <div class="install-grid">
        <article class="install-card">
            <div class="platform"><h3>macOS</h3><span>Apple Silicon</span></div>
            <pre><code>curl -fsSL https://raw.githubusercontent.com/Matanek/Silex/main/install.sh | sh</code></pre>
        </article>
        <article class="install-card">
            <div class="platform"><h3>Linux</h3><span>x64</span></div>
            <pre><code>curl -fsSL https://raw.githubusercontent.com/Matanek/Silex/main/install.sh | sh</code></pre>
        </article>
        <article class="install-card">
            <div class="platform"><h3>Windows</h3><span>x64 · PowerShell</span></div>
            <pre><code>irm https://raw.githubusercontent.com/Matanek/Silex/main/install.ps1 | iex</code></pre>
        </article>
    </div>

    <div class="quickstart" aria-labelledby="quickstart-title">
        <div class="quickstart-copy">
            <p class="eyebrow">{{ locale == 'fr' ? 'Premiers pas' : 'Next steps' }}</p>
            <h3 id="quickstart-title">{{ locale == 'fr' ? 'De l’installation au premier programme.' : 'From install to first program.' }}</h3>
            <p>{{ locale == 'fr' ? 'Vérifiez le compilateur, préparez la toolchain optionnelle puis lancez votre source.' : 'Verify the compiler, prepare the optional toolchain, then run your source.' }}</p>
        </div>
        <div class="quickstart-terminal" aria-label="{{ locale == 'fr' ? 'Commandes de démarrage Silex' : 'Silex quickstart commands' }}">
            <div class="quickstart-titlebar"><span></span><span></span><span></span><strong>Terminal</strong></div>
            <ol class="quickstart-steps">
                <li><span class="step-number">01</span><div><span class="step-label">{{ locale == 'fr' ? 'Vérifier l’installation' : 'Verify the installation' }}</span><code><b>$</b> silex --version</code></div></li>
                <li><span class="step-number">02</span><div><span class="step-label">{{ locale == 'fr' ? 'Préparer les outils optionnels' : 'Prepare optional tools' }}</span><code><b>$</b> silex setup</code></div></li>
                <li><span class="step-number">03</span><div><span class="step-label">{{ locale == 'fr' ? 'Lancer le programme' : 'Run the program' }}</span><code><b>$</b> silex run Main.sx</code></div></li>
            </ol>
        </div>
    </div>
</section>

<section class="section zed-extension" id="zed" aria-labelledby="zed-title">
    <div class="section-heading zed-intro">
        <p class="eyebrow">{{ locale == 'fr' ? 'Intégration éditeur' : 'Editor integration' }}</p>
        <h2 id="zed-title">{{ locale == 'fr' ? 'Installer l’extension Silex pour Zed.' : 'Install the Silex extension for Zed.' }}</h2>
        <p>{{ locale == 'fr' ? 'L’installation depuis la galerie est le parcours cible, mais elle attend encore sa validation. L’installation manuelle est la seule méthode disponible aujourd’hui.' : 'Installing from the gallery is the intended path, but it is still awaiting approval. Manual installation is the only method available today.' }}</p>
    </div>

    <div class="zed-methods">
        <article class="zed-method zed-method-quick" aria-labelledby="zed-quick-title">
            <div class="zed-method-header">
                <span class="zed-method-index">01</span>
                <span class="availability-badge availability-pending">{{ locale == 'fr' ? 'En attente de validation' : 'Awaiting approval' }}</span>
            </div>
            <h3 id="zed-quick-title">{{ locale == 'fr' ? 'Installation rapide' : 'Quick installation' }}</h3>
            <p class="zed-method-lede">{{ locale == 'fr' ? 'À terme, l’extension s’installera directement depuis la galerie intégrée à Zed. Ce parcours ne fonctionne pas encore.' : 'Eventually, the extension will install directly from Zed’s built-in gallery. This path does not work yet.' }}</p>

            <div class="zed-marketplace" aria-label="{{ locale == 'fr' ? 'Aperçu de la future installation depuis la galerie Zed' : 'Preview of the future Zed gallery installation' }}">
                <div class="zed-marketplace-titlebar">
                    <span>{{ locale == 'fr' ? 'Extensions Zed' : 'Zed Extensions' }}</span>
                    <span class="zed-marketplace-query">Silex</span>
                </div>
                <div class="zed-marketplace-result">
                    <span class="zed-extension-mark" aria-hidden="true">Sx</span>
                    <span><strong>Silex</strong><small>{{ locale == 'fr' ? 'Support du langage Silex' : 'Silex language support' }}</small></span>
                    <span class="zed-install-disabled" aria-disabled="true">{{ locale == 'fr' ? 'Indisponible' : 'Unavailable' }}</span>
                </div>
            </div>

            <p class="zed-pending-copy">{{ locale == 'fr' ? 'La publication est suivie chez Zed. La revue peut prendre du temps.' : 'Publication is tracked with Zed. The review may take some time.' }}</p>
            <a class="zed-pr-link" href="https://github.com/zed-industries/extensions/pull/7190">
                <span>{{ locale == 'fr' ? 'Suivre la PR zed-industries/extensions#7190' : 'Follow PR zed-industries/extensions#7190' }}</span>
                <b aria-hidden="true">→</b>
            </a>
        </article>

        <article class="zed-method zed-method-manual" aria-labelledby="zed-manual-title">
            <div class="zed-method-header">
                <span class="zed-method-index">02</span>
                <span class="availability-badge availability-live">{{ locale == 'fr' ? 'Disponible maintenant' : 'Available now' }}</span>
            </div>
            <h3 id="zed-manual-title">{{ locale == 'fr' ? 'Installation manuelle' : 'Manual installation' }}</h3>
            <p class="zed-method-lede">{{ locale == 'fr' ? 'Clonez le dépôt de l’extension et chargez-le dans Zed comme extension de développement.' : 'Clone the extension repository and load it into Zed as a development extension.' }}</p>

            <ol class="zed-manual-steps">
                <li>
                    <span>01</span>
                    <div>
                        <h4>{{ locale == 'fr' ? 'Préparer Silex et Rust' : 'Prepare Silex and Rust' }}</h4>
                        <p>{{ locale == 'fr' ? 'Vérifiez que Silex est dans le PATH, puis installez Rust avec rustup et sa cible WebAssembly.' : 'Check that Silex is in PATH, then install Rust with rustup and its WebAssembly target.' }}</p>
                        <pre><code><b>$</b> silex --version
<b>$</b> rustup target add wasm32-wasip2</code></pre>
                    </div>
                </li>
                <li>
                    <span>02</span>
                    <div>
                        <h4>{{ locale == 'fr' ? 'Cloner l’extension' : 'Clone the extension' }}</h4>
                        <pre><code><b>$</b> git clone https://github.com/Matanek/Silex-Extension-Zed.git</code></pre>
                    </div>
                </li>
                <li>
                    <span>03</span>
                    <div>
                        <h4>{{ locale == 'fr' ? 'Charger le dépôt dans Zed' : 'Load the repository in Zed' }}</h4>
                        <p>{{ locale == 'fr' ? 'Ouvrez la palette de commandes, lancez la commande ci-dessous, puis sélectionnez le dossier Silex-Extension-Zed.' : 'Open the command palette, run the command below, then select the Silex-Extension-Zed directory.' }}</p>
                        <kbd>zed: install dev extension</kbd>
                    </div>
                </li>
                <li>
                    <span>04</span>
                    <div>
                        <h4>{{ locale == 'fr' ? 'Ouvrir un fichier Silex' : 'Open a Silex file' }}</h4>
                        <p>{{ locale == 'fr' ? 'Ouvrez un fichier .sx : Zed sélectionne le langage Silex et démarre automatiquement silex lsp.' : 'Open an .sx file: Zed selects the Silex language and starts silex lsp automatically.' }}</p>
                    </div>
                </li>
            </ol>

            <div class="zed-manual-actions">
                <a class="button button-primary" href="https://github.com/Matanek/Silex-Extension-Zed">{{ locale == 'fr' ? 'Cloner depuis GitHub' : 'Clone from GitHub' }}</a>
                <a class="text-link" href="/{{ locale }}/docs/Tools/Install-Zed-extension.md">{{ locale == 'fr' ? 'Lire le guide détaillé' : 'Read the detailed guide' }} <span aria-hidden="true">→</span></a>
            </div>
        </article>
    </div>
</section>

{% if packages is not empty %}
<section class="section home-packages" id="packages" aria-labelledby="home-packages-title">
    <div class="section-heading home-packages-heading">
        <p class="eyebrow">{{ locale == 'fr' ? 'Écosystème public' : 'Public ecosystem' }}</p>
        <h2 id="home-packages-title">{{ packages|length }} {{ locale == 'fr' ? 'packages disponibles.' : 'packages available.' }}</h2>
        <p>{{ locale == 'fr' ? 'Le catalogue présente les packages inscrits et renvoie vers leurs dépôts, où chacun conserve sa documentation.' : 'The catalog lists registered packages and links to their repositories, where each package keeps its documentation.' }}</p>
    </div>

    <div class="package-catalog" data-package-count="{{ packages|length }}">
        {% for package in packages %}
            {% include '_package-card.twig' with {package: package, locale: locale} only %}
        {% endfor %}
    </div>

    <div class="home-packages-actions">
        <a class="button button-secondary" href="/{{ locale }}/packages">{{ locale == 'fr' ? 'Explorer tous les packages' : 'Explore all packages' }}</a>
        <a class="text-link" href="/{{ locale }}/registry">{{ locale == 'fr' ? 'Comment publier un package' : 'How to publish a package' }} <span aria-hidden="true">→</span></a>
    </div>
</section>
{% endif %}
{% endblock %}
