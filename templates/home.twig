{% extends 'layout.twig' %}

{% block title %}Silex — {{ locale == 'fr' ? 'Code moderne. Puissance native.' : 'Modern Code. Native Power.' }}{% endblock %}
{% block body_class %}home-page{% endblock %}

{% block content %}
<section class="hero" aria-labelledby="hero-title">
    <div class="section-container hero-layout">
    <div class="hero-copy">
        <div class="hero-meta">
            <p class="eyebrow">{{ locale == 'fr' ? 'Langage natif moderne' : 'Modern native language' }}</p>
            <a class="version-badge" href="{{ silex_version == 'development' ? 'https://github.com/Matanek/Silex/releases' : 'https://github.com/Matanek/Silex/releases/tag/v' ~ silex_version }}">
                {{ locale == 'fr' ? 'Version Silex' : 'Silex release' }} <strong>{{ silex_version == 'development' ? 'dev' : 'v' ~ silex_version }}</strong>
            </a>
        </div>
        <h1 id="hero-title"><span>{{ locale == 'fr' ? 'Code moderne' : 'Modern Code' }}</span><span>{{ locale == 'fr' ? 'Puissance native' : 'Native Power' }}</span></h1>
        <p class="lede">{{ locale == 'fr' ? 'Concentrez-vous sur votre jeu, pas sur sa configuration. Silex réunit un langage compilé moderne, une toolchain intégrée et un socle graphique cohérent pour passer plus vite du code à l’écran.' : 'Focus on your game, not its setup. Silex brings together a modern compiled language, an integrated toolchain, and a coherent graphics foundation so you can get from code to screen faster.' }}</p>
        <div class="actions">
            <a class="button button-primary" href="#install">{{ locale == 'fr' ? 'Installer Silex' : 'Install Silex' }}</a>
            <a class="button button-secondary" href="/{{ locale }}/docs">{{ locale == 'fr' ? 'Lire la documentation' : 'Read the docs' }}</a>
        </div>
    </div>

    <div class="code-window" aria-label="{{ locale == 'fr' ? 'Exemple de code Silex' : 'Silex code example' }}">
        <div class="code-titlebar"><span></span><span></span><span></span><strong>Main.sx</strong></div>
        <pre><code><span class="keyword">struct</span> <span class="type">Greeter</span> {
    <span class="keyword">let</span> name:<span class="type">str</span>
    <span class="keyword">func</span> message() <span class="type">str</span> {
        <span class="keyword">return</span> <span class="string">"Hello from $(self.name)!"</span>
    }
}

<span class="keyword">func</span> main() {
    print(Greeter(name:<span class="string">"Silex"</span>).message())
}</code></pre>
        <div class="terminal-line"><span>$</span> silex run Main.sx <strong>→ Hello from Silex!</strong></div>
    </div>
    </div>
</section>

{% set principles = locale == 'fr' ? [
    ['01', 'Simplicité', 'Un langage expressif, puissant et souple pour écrire un code agréable à lire et à maintenir.'],
    ['02', 'Efficacité', 'Compilation cross-platform pour Windows, macOS et Linux.'],
    ['03', 'Sécurité', 'Le typage et l’ownership rendent la circulation des données prévisible.']
] : [
    ['01', 'Simplicity', 'An expressive, powerful, and flexible language for writing code that is pleasant to read and maintain.'],
    ['02', 'Efficiency', 'Cross-platform compilation for Windows, macOS, and Linux.'],
    ['03', 'Safety', 'Typing and ownership make data flow predictable.']
] %}
<section class="principles" aria-label="{{ locale == 'fr' ? 'Principes de Silex' : 'Silex principles' }}">
    <div class="section-container">
        <div class="principles-heading">
            <p class="eyebrow">{{ locale == 'fr' ? 'Pourquoi Silex' : 'Why Silex' }}</p>
        </div>
        <div class="principles-layout">
        {% for principle in principles %}
            <article>
                <span class="number">{{ principle[0] }}</span>
                <h3>{{ principle[1] }}</h3>
                <p>{{ principle[2] }}</p>
            </article>
        {% endfor %}
        </div>
    </div>
</section>

<section class="section install" id="install" aria-labelledby="install-title">
    <div class="section-container">
    <div class="section-heading">
        <p class="eyebrow" id="install-title">{{ locale == 'fr' ? 'Installer Silex' : 'Install Silex' }}</p>
    </div>

    <div class="install-grid">
        <article class="install-card">
            <div class="platform"><h3>macOS</h3><span>Apple Silicon</span></div>
            <pre><code>curl -fsSL https://raw.githubusercontent.com/Matanek/Silex/main/install.sh | sh</code></pre>
        </article>
        <article class="install-card">
            <div class="platform"><h3>Linux</h3><span>x64</span></div>
            <pre><code>curl -fsSL https://raw.githubusercontent.com/Matanek/Silex/main/install.sh | sh</code></pre>
        </article>
        <article class="install-card">
            <div class="platform"><h3>Windows</h3><span>x64 · PowerShell</span></div>
            <pre><code>irm https://raw.githubusercontent.com/Matanek/Silex/main/install.ps1 | iex</code></pre>
        </article>
    </div>

    <div class="quickstart" aria-labelledby="quickstart-title">
        <div class="quickstart-copy">
            <p class="eyebrow">{{ locale == 'fr' ? 'Premiers pas' : 'Next steps' }}</p>
            <h3 id="quickstart-title">{{ locale == 'fr' ? 'De l’installation au premier programme.' : 'From install to first program.' }}</h3>
            <p>{{ locale == 'fr' ? 'Vérifiez le compilateur, préparez la toolchain optionnelle puis lancez votre source.' : 'Verify the compiler, prepare the optional toolchain, then run your source.' }}</p>
        </div>
        <div class="quickstart-terminal" aria-label="{{ locale == 'fr' ? 'Commandes de démarrage Silex' : 'Silex quickstart commands' }}">
            <div class="quickstart-titlebar"><span></span><span></span><span></span><strong>Terminal</strong></div>
            <ol class="quickstart-steps">
                <li><span class="step-number">01</span><div><span class="step-label">{{ locale == 'fr' ? 'Vérifier l’installation' : 'Verify the installation' }}</span><code><b>$</b> silex --version</code></div></li>
                <li><span class="step-number">02</span><div><span class="step-label">{{ locale == 'fr' ? 'Préparer les outils optionnels' : 'Prepare optional tools' }}</span><code><b>$</b> silex setup</code></div></li>
                <li><span class="step-number">03</span><div><span class="step-label">{{ locale == 'fr' ? 'Lancer le programme' : 'Run the program' }}</span><code><b>$</b> silex run Main.sx</code></div></li>
            </ol>
        </div>
    </div>
    </div>
</section>

<section class="section zed-extension" id="zed" aria-labelledby="zed-title">
    <div class="section-container">
    <div class="section-heading">
        <p class="eyebrow" id="zed-title">{{ locale == 'fr' ? 'Installer l’extension Zed' : 'Install the Zed extension' }}</p>
    </div>
    <div class="quickstart zed-setup">
        <div class="quickstart-copy zed-setup-copy">
            <p>{{ locale == 'fr' ? 'La procédure manuelle est disponible aujourd’hui : préparez Rust, clonez l’extension et chargez-la dans Zed.' : 'Manual installation is available today: prepare Rust, clone the extension, and load it into Zed.' }}</p>
            <div class="zed-setup-actions">
                <a class="button button-secondary" href="https://github.com/Matanek/Silex-Extension-Zed">{{ locale == 'fr' ? 'Dépôt de l’extension' : 'Extension repository' }}</a>
                <a class="text-link" href="/{{ locale }}/docs/Tools/Install-Zed-extension.md">{{ locale == 'fr' ? 'Guide détaillé' : 'Detailed guide' }} <span aria-hidden="true">→</span></a>
            </div>

            <aside class="zed-gallery-waiting" aria-label="{{ locale == 'fr' ? 'État de l’installation rapide' : 'Quick installation status' }}">
                <div>
                    <span>{{ locale == 'fr' ? 'Installation rapide' : 'Quick installation' }}</span>
                    <span class="zed-path-status zed-path-status-pending">{{ locale == 'fr' ? 'En attente de validation' : 'Awaiting approval' }}</span>
                </div>
                <p>{{ locale == 'fr' ? 'L’installation depuis la galerie Zed ne fonctionne pas encore.' : 'Installation from the Zed gallery does not work yet.' }}</p>
                <a href="https://github.com/zed-industries/extensions/pull/7190">{{ locale == 'fr' ? 'Suivre la PR #7190' : 'Follow PR #7190' }} <span aria-hidden="true">→</span></a>
            </aside>
        </div>

        <div class="quickstart-terminal zed-setup-terminal" aria-label="{{ locale == 'fr' ? 'Installation manuelle de l’extension Zed' : 'Manual Zed extension installation' }}">
            <div class="quickstart-titlebar">
                <span></span><span></span><span></span>
                <strong class="zed-titlebar-availability">{{ locale == 'fr' ? 'Disponible maintenant' : 'Available now' }}</strong>
            </div>
            <ol class="quickstart-steps zed-manual-steps">
                <li>
                    <span class="step-number">01</span>
                    <div>
                        <span class="step-label">{{ locale == 'fr' ? 'Préparer Silex et Rust' : 'Prepare Silex and Rust' }}</span>
                        <div class="zed-step-commands">
                            <code><b>$</b> silex --version</code>
                            <code><b>$</b> rustup target add wasm32-wasip2</code>
                        </div>
                    </div>
                </li>
                <li>
                    <span class="step-number">02</span>
                    <div>
                        <span class="step-label">{{ locale == 'fr' ? 'Cloner l’extension' : 'Clone the extension' }}</span>
                        <div class="zed-step-commands">
                            <code><b>$</b> git clone https://github.com/Matanek/Silex-Extension-Zed.git</code>
                        </div>
                    </div>
                </li>
                <li>
                    <span class="step-number">03</span>
                    <div>
                        <span class="step-label">{{ locale == 'fr' ? 'Charger l’extension dans Zed' : 'Load the extension in Zed' }}</span>
                        <div class="zed-step-commands">
                            <code><b>›</b> zed: install dev extension</code>
                        </div>
                        <p class="zed-step-note">{{ locale == 'fr' ? 'Sélectionnez le dossier Silex-Extension-Zed, puis ouvrez un fichier .sx.' : 'Select the Silex-Extension-Zed directory, then open an .sx file.' }}</p>
                    </div>
                </li>
            </ol>
        </div>
    </div>
    </div>
</section>

{% if packages is not empty %}
<section class="section home-packages" id="packages" aria-labelledby="home-packages-title">
    <div class="section-container">
    <div class="section-heading home-packages-heading">
        <p class="eyebrow">{{ locale == 'fr' ? 'Écosystème public' : 'Public ecosystem' }}</p>
        <h2 id="home-packages-title">{{ packages|length }} {{ locale == 'fr' ? 'packages disponibles.' : 'packages available.' }}</h2>
        <p>{{ locale == 'fr' ? 'Le catalogue présente les packages inscrits et renvoie vers leurs dépôts, où chacun conserve sa documentation.' : 'The catalog lists registered packages and links to their repositories, where each package keeps its documentation.' }}</p>
    </div>

    <div class="package-catalog" data-package-count="{{ packages|length }}">
        {% for package in packages %}
            {% include '_package-card.twig' with {package: package, locale: locale} only %}
        {% endfor %}
    </div>

    <div class="home-packages-actions">
        <a class="button button-secondary" href="/{{ locale }}/packages">{{ locale == 'fr' ? 'Explorer tous les packages' : 'Explore all packages' }}</a>
        <a class="text-link" href="/{{ locale }}/registry">{{ locale == 'fr' ? 'Comment publier un package' : 'How to publish a package' }} <span aria-hidden="true">→</span></a>
    </div>
    </div>
</section>
{% endif %}
{% endblock %}
