{% extends 'layout.twig' %}

{% block title %}Silex — Modern Code. Native Power.{% endblock %}

{% block content %}
<section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
        <div class="hero-meta">
            <p class="eyebrow">Modern native language</p>
            <a class="version-badge" href="{{ silex_version == 'development' ? 'https://github.com/Matanek/Silex/releases' : 'https://github.com/Matanek/Silex/releases/tag/v' ~ silex_version }}">
                Silex release <strong>{{ silex_version == 'development' ? 'dev' : 'v' ~ silex_version }}</strong>
            </a>
        </div>
        <h1 id="hero-title"><span>Modern Code</span><span>Native Power</span></h1>
        <p class="lede">Silex is an experimental native language and compiler, with modules, packages and an integrated toolchain.</p>
        <div class="actions">
            <a class="button button-primary" href="#install">Install Silex</a>
            <a class="button button-secondary" href="/docs">Read the docs</a>
        </div>
    </div>

    <div class="code-window" aria-label="Silex code example">
        <div class="code-titlebar"><span></span><span></span><span></span><strong>Main.sx</strong></div>
        <pre><code><span class="keyword">func</span> answer() <span class="type">int</span> {
    <span class="keyword">return</span> 40 + 2
}

<span class="keyword">func</span> main() {
    print(answer())
}</code></pre>
        <div class="terminal-line"><span>$</span> silex run Main.sx <strong>→ 42</strong></div>
    </div>
</section>

{% set principles = [
    ['01', 'Simple', 'A focused language and integrated toolchain keep writing, building and running programs direct.'],
    ['02', 'Explicit semantics', 'Values, references and moves make the way data flows through a program clear.'],
    ['03', 'Native executables', 'The compiler directly produces native executables for its supported targets.']
] %}
<section class="principles" aria-label="Silex principles">
    {% for principle in principles %}
        <article>
            <span class="number">{{ principle[0] }}</span>
            <h2>{{ principle[1] }}</h2>
            <p>{{ principle[2] }}</p>
        </article>
    {% endfor %}
</section>

<section class="section install" id="install" aria-labelledby="install-title">
    <div class="section-heading">
        <p class="eyebrow">Start here</p>
        <h2 id="install-title">Install Silex</h2>
        <p>The standalone compiler does not require Zig or Git on the developer machine.</p>
    </div>

    <div class="install-grid">
        <article class="install-card">
            <div class="platform"><h3>macOS</h3><span>Apple Silicon</span></div>
            <pre><code>curl -fsSL https://raw.githubusercontent.com/Matanek/Silex/main/install.sh | sh</code></pre>
        </article>
        <article class="install-card">
            <div class="platform"><h3>Linux</h3><span>x64</span></div>
            <pre><code>curl -fsSL https://raw.githubusercontent.com/Matanek/Silex/main/install.sh | sh</code></pre>
        </article>
        <article class="install-card">
            <div class="platform"><h3>Windows</h3><span>x64 · PowerShell</span></div>
            <pre><code>irm https://raw.githubusercontent.com/Matanek/Silex/main/install.ps1 | iex</code></pre>
        </article>
    </div>

    <div class="quickstart" aria-labelledby="quickstart-title">
        <div class="quickstart-copy">
            <p class="eyebrow">Next steps</p>
            <h3 id="quickstart-title">From install to first program.</h3>
            <p>Verify the compiler, prepare the optional toolchain, then run your source.</p>
        </div>
        <div class="quickstart-terminal" aria-label="Silex quickstart commands">
            <div class="quickstart-titlebar"><span></span><span></span><span></span><strong>Terminal</strong></div>
            <ol class="quickstart-steps">
                <li><span class="step-number">01</span><div><span class="step-label">Verify the installation</span><code><b>$</b> silex --version</code></div></li>
                <li><span class="step-number">02</span><div><span class="step-label">Prepare optional tools</span><code><b>$</b> silex setup</code></div></li>
                <li><span class="step-number">03</span><div><span class="step-label">Run the program</span><code><b>$</b> silex run Main.sx</code></div></li>
            </ol>
        </div>
    </div>
</section>

{% if packages is not empty %}
<section class="section home-packages" id="packages" aria-labelledby="home-packages-title">
    <div class="section-heading home-packages-heading">
        <p class="eyebrow">Public ecosystem</p>
        <h2 id="home-packages-title">{{ packages|length }} packages available.</h2>
        <p>Each package owns its manifest and canonical documentation; the website brings them together for direct discovery.</p>
    </div>

    <div class="package-catalog" data-package-count="{{ packages|length }}">
        {% for package in packages %}
            {% include '_package-card.twig' with {package: package} only %}
        {% endfor %}
    </div>

    <div class="home-packages-actions">
        <a class="button button-secondary" href="/packages">Explore all packages</a>
        <a class="text-link" href="/registry">How to publish a package <span aria-hidden="true">→</span></a>
    </div>
</section>
{% endif %}
{% endblock %}
