{% extends 'layout.twig' %}

{% block title %}Silex — {{ locale == 'fr' ? 'Langage de programmation moderne' : 'Modern programming language' }}{% endblock %}

{% block content %}
<section class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 -z-10 h-96 bg-[radial-gradient(circle_at_top,_rgba(34,211,238,0.18),_transparent_60%)]"></div>
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
        <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.24em] text-cyan-400">Silex Programming Language</p>
        <h1 class="max-w-4xl text-5xl font-semibold tracking-tight text-white sm:text-7xl">
            {{ locale == 'fr' ? 'Construire clairement. Compiler nativement.' : 'Build clearly. Compile natively.' }}
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300">
            {{ locale == 'fr'
                ? 'Un langage moderne pour écrire des programmes lisibles, composables et proches de la machine.'
                : 'A modern language for writing readable, composable programs close to the machine.' }}
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
            <a class="rounded-lg bg-cyan-400 px-5 py-3 font-semibold text-silex-950 transition hover:bg-cyan-300" href="/{{ locale }}/docs">
                {{ locale == 'fr' ? 'Lire la documentation' : 'Read the documentation' }}
            </a>
            <a class="rounded-lg border border-white/15 px-5 py-3 font-semibold text-white transition hover:border-white/30 hover:bg-white/5" href="https://github.com/Matanek/Silex">
                GitHub
            </a>
        </div>
    </div>
</section>

<section class="mx-auto grid max-w-6xl gap-5 px-6 pb-24 md:grid-cols-3">
    {% set cards = locale == 'fr' ? [
        ['Syntaxe expressive', 'Un code compact qui conserve une intention claire.'],
        ['Compilation native', 'Une toolchain conçue pour produire et exécuter des programmes natifs.'],
        ['Packages composables', 'Un écosystème modulaire dont chaque package conserve sa documentation.']
    ] : [
        ['Expressive syntax', 'Compact code that keeps its intent clear.'],
        ['Native compilation', 'A toolchain designed to build and run native programs.'],
        ['Composable packages', 'A modular ecosystem where each package owns its documentation.']
    ] %}

    {% for card in cards %}
        <article class="rounded-2xl border border-white/10 bg-white/[0.035] p-6">
            <h2 class="text-lg font-semibold text-white">{{ card[0] }}</h2>
            <p class="mt-3 leading-7 text-slate-400">{{ card[1] }}</p>
        </article>
    {% endfor %}
</section>
{% endblock %}
