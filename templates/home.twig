{% extends 'layout.twig' %}

{% block title %}Silex — {{ locale == 'fr' ? 'Code moderne. Puissance native.' : 'Modern Code. Native Power.' }}{% endblock %}
{% block body_class %}home-page{% endblock %}

{% block content %}
<section class="hero" aria-labelledby="hero-title">
    <div class="section-container hero-layout">
    <div class="hero-copy">
        <div class="hero-meta">
            <p class="eyebrow">{{ locale == 'fr' ? 'Langage natif moderne' : 'Modern native language' }}</p>
            <a class="version-badge" href="{{ silex_version == 'development' ? 'https://github.com/Matanek/Silex/releases' : 'https://github.com/Matanek/Silex/releases/tag/v' ~ silex_version }}">
                {{ locale == 'fr' ? 'Version Silex' : 'Silex release' }} <strong>{{ silex_version == 'development' ? 'dev' : 'v' ~ silex_version }}</strong>
            </a>
        </div>
        <h1 id="hero-title"><span>{{ locale == 'fr' ? 'Code moderne' : 'Modern Code' }}</span><span>{{ locale == 'fr' ? 'Puissance native' : 'Native Power' }}</span></h1>
        <p class="lede">{{ locale == 'fr' ? 'Concentrez-vous sur votre jeu, pas sur sa configuration. Silex réunit un langage compilé moderne, une toolchain intégrée et un socle graphique cohérent pour passer plus vite du code à l’écran.' : 'Focus on your game, not its setup. Silex brings together a modern compiled language, an integrated toolchain, and a coherent graphics foundation so you can get from code to screen faster.' }}</p>
        <div class="actions">
            <a class="button button-primary" href="#install">{{ locale == 'fr' ? 'Installer Silex' : 'Install Silex' }}</a>
            <a class="button button-secondary" href="/{{ locale }}/docs">{{ locale == 'fr' ? 'Lire la documentation' : 'Read the docs' }}</a>
        </div>
    </div>

    <div class="code-window" aria-label="{{ locale == 'fr' ? 'Exemple de code Silex' : 'Silex code example' }}">
        <div class="code-titlebar"><span></span><span></span><span></span><strong>Main.sx</strong></div>
        <pre><code><span class="keyword">struct</span> <span class="type">Greeter</span> {
    <span class="keyword">let</span> name:<span class="type">str</span>
    <span class="keyword">func</span> message() <span class="type">str</span> {
        <span class="keyword">return</span> <span class="string">"Hello from $(self.name)!"</span>
    }
}

<span class="keyword">func</span> main() {
    print(Greeter(name:<span class="string">"Silex"</span>).message())
}</code></pre>
        <div class="terminal-line"><span>$</span> silex run Main.sx <strong>→ Hello from Silex!</strong></div>
    </div>
    </div>
</section>

{% set principles = locale == 'fr' ? [
    ['01', 'Simplicité', 'Un langage expressif, puissant et souple pour écrire un code agréable à lire et à maintenir.'],
    ['02', 'Efficacité', 'Compilation cross-platform pour Windows, macOS et Linux.'],
    ['03', 'Sécurité', 'Le typage et l’ownership rendent la circulation des données prévisible.']
] : [
    ['01', 'Simplicity', 'An expressive, powerful, and flexible language for writing code that is pleasant to read and maintain.'],
    ['02', 'Efficiency', 'Cross-platform compilation for Windows, macOS, and Linux.'],
    ['03', 'Safety', 'Typing and ownership make data flow predictable.']
] %}
<section class="principles" aria-label="{{ locale == 'fr' ? 'Principes de Silex' : 'Silex principles' }}">
    <div class="section-container">
        <div class="principles-heading">
            <p class="eyebrow">{{ locale == 'fr' ? 'Pourquoi Silex' : 'Why Silex' }}</p>
        </div>
        <div class="principles-layout">
        {% for principle in principles %}
            <article>
                <span class="number">{{ principle[0] }}</span>
                <h3>{{ principle[1] }}</h3>
                <p>{{ principle[2] }}</p>
            </article>
        {% endfor %}
        </div>
    </div>
</section>

<section class="section install" id="install" aria-labelledby="install-title">
    <div class="section-container">
    <div class="section-heading">
        <p class="eyebrow" id="install-title">{{ locale == 'fr' ? 'Installer Silex' : 'Install Silex' }}</p>
    </div>

    <div class="install-grid">
        <article class="install-card">
            <div class="platform"><h3>macOS</h3><span>Apple Silicon</span></div>
            <pre><code>curl -fsSL https://raw.githubusercontent.com/Matanek/Silex/main/install.sh | sh</code></pre>
        </article>
        <article class="install-card">
            <div class="platform"><h3>Linux</h3><span>x64</span></div>
            <pre><code>curl -fsSL https://raw.githubusercontent.com/Matanek/Silex/main/install.sh | sh</code></pre>
        </article>
        <article class="install-card">
            <div class="platform"><h3>Windows</h3><span>x64 · PowerShell</span></div>
            <pre><code>irm https://raw.githubusercontent.com/Matanek/Silex/main/install.ps1 | iex</code></pre>
        </article>
    </div>

    <div class="quickstart" aria-labelledby="quickstart-title">
        <div class="quickstart-copy">
            <p class="eyebrow">{{ locale == 'fr' ? 'Premiers pas' : 'Next steps' }}</p>
            <h3 id="quickstart-title">{{ locale == 'fr' ? 'De l’installation au premier programme.' : 'From install to first program.' }}</h3>
            <p>{{ locale == 'fr' ? 'Vérifiez le compilateur, préparez la toolchain optionnelle puis lancez votre source.' : 'Verify the compiler, prepare the optional toolchain, then run your source.' }}</p>
        </div>
        <div class="quickstart-terminal" aria-label="{{ locale == 'fr' ? 'Commandes de démarrage Silex' : 'Silex quickstart commands' }}">
            <div class="quickstart-titlebar"><span></span><span></span><span></span><strong>Terminal</strong></div>
            <ol class="quickstart-steps">
                <li><span class="step-number">01</span><div><span class="step-label">{{ locale == 'fr' ? 'Vérifier l’installation' : 'Verify the installation' }}</span><code><b>$</b> silex --version</code></div></li>
                <li><span class="step-number">02</span><div><span class="step-label">{{ locale == 'fr' ? 'Préparer les outils optionnels' : 'Prepare optional tools' }}</span><code><b>$</b> silex setup</code></div></li>
                <li><span class="step-number">03</span><div><span class="step-label">{{ locale == 'fr' ? 'Lancer le programme' : 'Run the program' }}</span><code><b>$</b> silex run Main.sx</code></div></li>
            </ol>
        </div>
    </div>
    </div>
</section>

<section class="section zed-extension" id="zed" aria-labelledby="zed-title">
    <div class="section-container">
    <div class="section-heading">
        <p class="eyebrow" id="zed-title">{{ locale == 'fr' ? 'Installer l’extension Zed' : 'Install the Zed extension' }}</p>
    </div>
    <div class="quickstart zed-setup">
        <div class="quickstart-copy zed-setup-copy">
            <p>{{ locale == 'fr' ? 'La procédure manuelle est disponible aujourd’hui : préparez Rust, clonez l’extension et chargez-la dans Zed.' : 'Manual installation is available today: prepare Rust, clone the extension, and load it into Zed.' }}</p>
            <div class="zed-setup-actions">
                <a class="button button-secondary" href="https://github.com/Matanek/Silex-Extension-Zed">{{ locale == 'fr' ? 'Dépôt de l’extension' : 'Extension repository' }}</a>
                <a class="text-link" href="/{{ locale }}/docs/Tools/Install-Zed-extension.md">{{ locale == 'fr' ? 'Guide détaillé' : 'Detailed guide' }} <span aria-hidden="true">→</span></a>
            </div>

            <aside class="zed-gallery-waiting" aria-label="{{ locale == 'fr' ? 'État de l’installation rapide' : 'Quick installation status' }}">
                <div>
                    <span>{{ locale == 'fr' ? 'Installation rapide' : 'Quick installation' }}</span>
                    <span class="zed-path-status zed-path-status-pending">{{ locale == 'fr' ? 'En attente de validation' : 'Awaiting approval' }}</span>
                </div>
                <p>{{ locale == 'fr' ? 'L’installation depuis la galerie Zed ne fonctionne pas encore.' : 'Installation from the Zed gallery does not work yet.' }}</p>
                <a href="https://github.com/zed-industries/extensions/pull/7190">{{ locale == 'fr' ? 'Suivre la PR #7190' : 'Follow PR #7190' }} <span aria-hidden="true">→</span></a>
            </aside>
        </div>

        <div class="quickstart-terminal zed-setup-terminal" aria-label="{{ locale == 'fr' ? 'Installation manuelle de l’extension Zed' : 'Manual Zed extension installation' }}">
            <div class="quickstart-titlebar">
                <span></span><span></span><span></span>
                <strong class="zed-titlebar-availability">{{ locale == 'fr' ? 'Disponible maintenant' : 'Available now' }}</strong>
            </div>
            <ol class="quickstart-steps zed-manual-steps">
                <li>
                    <span class="step-number">01</span>
                    <div>
                        <span class="step-label">{{ locale == 'fr' ? 'Préparer Silex et Rust' : 'Prepare Silex and Rust' }}</span>
                        <div class="zed-step-commands">
                            <code><b>$</b> silex --version</code>
                            <code><b>$</b> rustup target add wasm32-wasip2</code>
                        </div>
                    </div>
                </li>
                <li>
                    <span class="step-number">02</span>
                    <div>
                        <span class="step-label">{{ locale == 'fr' ? 'Cloner l’extension' : 'Clone the extension' }}</span>
                        <div class="zed-step-commands">
                            <code><b>$</b> git clone https://github.com/Matanek/Silex-Extension-Zed.git</code>
                        </div>
                    </div>
                </li>
                <li>
                    <span class="step-number">03</span>
                    <div>
                        <span class="step-label">{{ locale == 'fr' ? 'Charger l’extension dans Zed' : 'Load the extension in Zed' }}</span>
                        <div class="zed-step-commands">
                            <code><b>›</b> zed: install dev extension</code>
                        </div>
                        <p class="zed-step-note">{{ locale == 'fr' ? 'Sélectionnez le dossier Silex-Extension-Zed, puis ouvrez un fichier .sx.' : 'Select the Silex-Extension-Zed directory, then open an .sx file.' }}</p>
                    </div>
                </li>
            </ol>
        </div>
    </div>
    </div>
</section>

{% if packages is not empty %}
<section class="section home-packages" id="packages" aria-labelledby="home-packages-title">
    <div class="section-container">
    <div class="section-heading home-packages-heading">
        <p class="eyebrow">{{ locale == 'fr' ? 'Écosystème public' : 'Public ecosystem' }}</p>
        <h2 id="home-packages-title">{{ packages|length }} {{ locale == 'fr' ? 'packages disponibles.' : 'packages available.' }}</h2>
        <p>{{ locale == 'fr' ? 'Le catalogue présente les packages inscrits et renvoie vers leurs dépôts, où chacun conserve sa documentation.' : 'The catalog lists registered packages and links to their repositories, where each package keeps its documentation.' }}</p>
    </div>

    <div class="package-catalog" data-package-count="{{ packages|length }}">
        {% for package in packages %}
            {% include '_package-card.twig' with {package: package, locale: locale} only %}
        {% endfor %}
    </div>

    <div class="home-packages-actions">
        <a class="button button-secondary" href="/{{ locale }}/packages">{{ locale == 'fr' ? 'Explorer tous les packages' : 'Explore all packages' }}</a>
        <a class="text-link" href="/{{ locale }}/registry">{{ locale == 'fr' ? 'Comment publier un package' : 'How to publish a package' }} <span aria-hidden="true">→</span></a>
    </div>
    </div>
</section>
{% endif %}

{% set showcase_items = [
    {slug: 'canvas-shapes', title_fr: 'Formes et tracés Canvas', title_en: 'Canvas shapes and paths', description_fr: 'Primitives, courbes, styles, dégradés et composition 2D avec GFX.Canvas.', description_en: 'Primitives, curves, styles, gradients, and 2D composition with GFX.Canvas.', alt_fr: 'Galerie sombre présentant des lignes, courbes, formes et compositions colorées rendues par GFX.Canvas.', alt_en: 'Dark gallery of colorful lines, curves, shapes, and compositions rendered by GFX.Canvas.'},
    {slug: 'shadow-debug', title_fr: 'Debug des ombres 3D', title_en: '3D shadow debugging', description_fr: 'Volumes de caméra et de lumière visualisés autour d’une scène éclairée.', description_en: 'Camera and light volumes visualized around a lit scene.', alt_fr: 'Cube éclairé sur un plan avec volumes de caméra et de lumière affichés en fil de fer.', alt_en: 'Lit cube on a plane with camera and light volumes shown as wireframes.'},
    {slug: 'gfx-world', title_fr: 'Monde GFX temps réel', title_en: 'Real-time GFX world', description_fr: 'Scène 3D texturée, ombrée et instrumentée à 120 images par seconde.', description_en: 'Textured, shadowed, and instrumented 3D scene running at 120 frames per second.', alt_fr: 'Paysage 3D composé de rochers, d’arbres et d’herbe avec panneau de performances GFX.', alt_en: '3D landscape with rocks, trees, grass, and a GFX performance panel.'},
    {slug: 'particle-system', title_fr: 'Système de particules', title_en: 'Particle system', description_fr: 'Des milliers de particules 2D animées et rendues à 120 images par seconde.', description_en: 'Thousands of animated 2D particles rendered at 120 frames per second.', alt_fr: 'Nuage dense de particules triangulaires cyan et violettes sur fond sombre.', alt_en: 'Dense cloud of cyan and violet triangular particles on a dark background.'},
    {slug: 'plot-overview', title_fr: 'Plot — Vue d’ensemble', title_en: 'Plot — Overview', description_fr: 'Courbes, barres, chandeliers et boîtes à moustaches composés en Silex.', description_en: 'Lines, bars, candlesticks, and box plots composed in Silex.', alt_fr: 'Planche claire de quatre graphiques Plot : croissance, benchmark, marché et dispersion.', alt_en: 'Light dashboard of four Plot charts: growth, benchmark, market, and measurement spread.'},
    {slug: 'plot-science', title_fr: 'Plot — Données scientifiques', title_en: 'Plot — Scientific data', description_fr: 'Intervalles, histogrammes, matrices de confusion et barres d’erreur.', description_en: 'Intervals, histograms, confusion matrices, and error bars.', alt_fr: 'Planche de graphiques scientifiques avec précision, distribution, matrice de confusion et temps d’inférence.', alt_en: 'Scientific chart board with accuracy, distribution, confusion matrix, and inference time.'},
    {slug: 'plot-circular', title_fr: 'Plot — Graphiques circulaires', title_en: 'Plot — Circular charts', description_fr: 'Camemberts, anneaux et visualisations de couverture avec leurs légendes.', description_en: 'Pie, doughnut, and coverage charts with their legends.', alt_fr: 'Planche de quatre graphiques circulaires colorés présentant revenus, plateformes, objectif et couverture.', alt_en: 'Board of four colorful circular charts showing revenue, platforms, target, and coverage.'},
    {slug: 'plot-areas', title_fr: 'Plot — Aires et progressions', title_en: 'Plot — Areas and progressions', description_fr: 'Aires superposées, piles, pyramides et entonnoirs de conversion.', description_en: 'Layered areas, stacks, pyramids, and conversion funnels.', alt_fr: 'Planche de graphiques Plot avec aires, activité empilée, pyramide et entonnoir.', alt_en: 'Plot board with area charts, stacked activity, pyramid, and funnel.'},
    {slug: 'material-showcase', title_fr: 'Matériaux PBR', title_en: 'PBR materials', description_fr: 'Couleur, normales, émission, métal, rugosité, occlusion et transparence.', description_en: 'Color, normals, emission, metalness, roughness, occlusion, and transparency.', alt_fr: 'Planche 3D de sphères et objets démontrant différentes propriétés de matériaux PBR.', alt_en: '3D board of spheres and objects demonstrating different PBR material properties.'},
    {slug: 'vector-font-typography', title_fr: 'Typographie vectorielle', title_en: 'Vector typography', description_fr: 'Shaping Unicode, ligatures, crénage, scripts multiples et métriques de glyphes.', description_en: 'Unicode shaping, ligatures, kerning, multiple scripts, and glyph metrics.', alt_fr: 'Interface sombre de démonstration typographique avec plusieurs alphabets et métriques de glyphes.', alt_en: 'Dark typography showcase interface with multiple alphabets and glyph metrics.'},
    {slug: 'vector-font-scene2d', title_fr: 'Texte vectoriel Scene2D', title_en: 'Scene2D vector text', description_fr: 'GlyphRuns retenus, contours indépendants de la résolution et tessellation partagée.', description_en: 'Retained GlyphRuns, resolution-independent outlines, and shared tessellation.', alt_fr: 'Interface Scene2D affichant le mot OBé rempli et ses contours vectoriels annotés.', alt_en: 'Scene2D interface showing the word OBé filled and as annotated vector outlines.'},
    {slug: 'canvas-clock', title_fr: 'Horloge Canvas', title_en: 'Canvas clock', description_fr: 'Un widget complet dessiné par composition de formes, de texte et de transformations.', description_en: 'A complete widget drawn by composing shapes, text, and transformations.', alt_fr: 'Grande horloge analogique claire dessinée avec des graduations, chiffres et aiguilles.', alt_en: 'Large light analog clock drawn with tick marks, numbers, and hands.'},
    {slug: 'shadow-volumes', title_fr: 'Lumières et volumes d’ombre', title_en: 'Lights and shadow volumes', description_fr: 'Inspection des frustums, sources lumineuses et ombres portées dans une scène 3D.', description_en: 'Inspection of frustums, light sources, and cast shadows in a 3D scene.', alt_fr: 'Scène 3D sombre avec deux objets cyan, leurs ombres et plusieurs volumes de debug.', alt_en: 'Dark 3D scene with two cyan objects, their shadows, and several debug volumes.'}
] %}

<section class="section showcase" id="showcase" aria-labelledby="showcase-title">
    <div class="section-container">
        <div class="section-heading showcase-heading">
            <div>
                <p class="eyebrow">{{ locale == 'fr' ? 'Construit avec Silex' : 'Built with Silex' }}</p>
                <h2 id="showcase-title">{{ locale == 'fr' ? 'Déjà capable. Déjà visible.' : 'Already capable. Already visible.' }}</h2>
            </div>
            <p>{{ locale == 'fr' ? 'Rendu 2D et 3D, visualisation de données, typographie et outils graphiques : ces images proviennent d’applications écrites en Silex.' : '2D and 3D rendering, data visualization, typography, and graphics tools: these images come from applications written in Silex.' }}</p>
        </div>

        <div class="showcase-grid" data-showcase-gallery data-count-label="{{ locale == 'fr' ? '{current} sur {total}' : '{current} of {total}' }}">
            {% for item in showcase_items %}
                {% set title = locale == 'fr' ? item.title_fr : item.title_en %}
                {% set description = locale == 'fr' ? item.description_fr : item.description_en %}
                {% set alt = locale == 'fr' ? item.alt_fr : item.alt_en %}
                <a class="showcase-card" href="/assets/showcase/full/{{ item.slug }}.webp" data-showcase-item data-title="{{ title|e('html_attr') }}" data-description="{{ description|e('html_attr') }}" data-alt="{{ alt|e('html_attr') }}" aria-haspopup="dialog" aria-label="{{ (locale == 'fr' ? 'Agrandir ' : 'Enlarge ') ~ title }}">
                    <figure>
                        <div class="showcase-thumbnail">
                            <img src="/assets/showcase/thumbs/{{ item.slug }}.webp" alt="{{ alt }}" width="720" height="450" loading="lazy" decoding="async">
                            <span aria-hidden="true">↗</span>
                        </div>
                        <figcaption>
                            <span>{{ '%02d'|format(loop.index) }}</span>
                            <div>
                                <h3>{{ title }}</h3>
                                <p>{{ description }}</p>
                            </div>
                        </figcaption>
                    </figure>
                </a>
            {% endfor %}
        </div>
    </div>
</section>

<dialog class="showcase-lightbox" data-showcase-lightbox aria-labelledby="showcase-lightbox-title">
    <div class="showcase-lightbox-frame">
        <button class="showcase-lightbox-close" type="button" data-showcase-close aria-label="{{ locale == 'fr' ? 'Fermer la galerie' : 'Close gallery' }}">×</button>
        <button class="showcase-lightbox-nav showcase-lightbox-previous" type="button" data-showcase-previous aria-label="{{ locale == 'fr' ? 'Image précédente' : 'Previous image' }}">←</button>
        <figure>
            <div class="showcase-lightbox-stage"><img data-showcase-image src="" alt=""></div>
            <figcaption aria-live="polite">
                <span data-showcase-count></span>
                <div>
                    <h3 id="showcase-lightbox-title" data-showcase-title></h3>
                    <p data-showcase-description></p>
                </div>
            </figcaption>
        </figure>
        <button class="showcase-lightbox-nav showcase-lightbox-next" type="button" data-showcase-next aria-label="{{ locale == 'fr' ? 'Image suivante' : 'Next image' }}">→</button>
    </div>
</dialog>

<script src="/assets/showcase.js" defer></script>
{% endblock %}
