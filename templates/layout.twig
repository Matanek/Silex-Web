<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{% block description %}Silex is an experimental native language and compiler.{% endblock %}">
    <meta name="theme-color" content="#0c0c0d">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <title>{% block title %}Silex{% endblock %}</title>
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body>
    <!-- Silex Web release: {{ release }} -->
    <header class="site-header">
        <a class="brand" href="/" aria-label="Silex home">
            <img class="brand-mark" src="/icon.svg" alt="">
            <span>Silex</span>
        </a>

        <nav class="site-navigation" aria-label="Main navigation">
            <a href="/docs">Docs</a>
            <a href="/#install">Install</a>
            <a href="/packages">Packages</a>
            <a class="wide-link" href="/registry">Registry</a>
            <a class="wide-link" href="https://github.com/Matanek/Silex">GitHub</a>
        </nav>
    </header>

    <main>{% block content %}{% endblock %}</main>

    <footer class="site-footer">
        <span>
            <a href="https://github.com/Matanek/Silex">Silex language</a>
            developed by
            <a href="https://github.com/Matanek">Matanek</a>.
        </span>
        <a href="https://github.com/Matanek/Silex/blob/main/LICENSE">Apache-2.0 with LLVM exception</a>
    </footer>
</body>
</html>
