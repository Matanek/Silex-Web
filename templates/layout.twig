<!doctype html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{% block description %}{{ locale == 'fr' ? 'Silex est un langage et un compilateur natif expérimental.' : 'Silex is an experimental native language and compiler.' }}{% endblock %}">
    <meta name="theme-color" content="#030712">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <title>{% block title %}Silex{% endblock %}</title>
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body class="{% block body_class %}{% endblock %}">
    <!-- Silex Web release: {{ release }} -->
    <header class="site-header">
        <div class="site-header-inner">
            <a class="brand" href="/{{ locale }}/" aria-label="{{ locale == 'fr' ? 'Accueil Silex' : 'Silex home' }}">
                <img class="brand-mark" src="/icon.svg" alt="">
                <span>Silex</span>
            </a>

            <nav class="site-navigation desktop-navigation" aria-label="{{ locale == 'fr' ? 'Navigation principale' : 'Main navigation' }}">
                {% include '_site-navigation-links.twig' %}
            </nav>

            <button
                class="navigation-toggle"
                type="button"
                aria-controls="mobile-navigation"
                aria-expanded="false"
                aria-label="{{ locale == 'fr' ? 'Ouvrir le menu' : 'Open menu' }}"
                data-navigation-toggle
                data-open-label="{{ locale == 'fr' ? 'Ouvrir le menu' : 'Open menu' }}"
                data-close-label="{{ locale == 'fr' ? 'Fermer le menu' : 'Close menu' }}"
            >
                <span class="navigation-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
            </button>
        </div>
    </header>

    <div class="mobile-navigation-backdrop" aria-hidden="true" data-navigation-backdrop></div>
    <aside class="mobile-navigation-panel" id="mobile-navigation" role="dialog" aria-modal="true" aria-label="{{ locale == 'fr' ? 'Menu principal' : 'Main menu' }}" aria-hidden="true" inert data-navigation-panel>
        <p class="mobile-navigation-heading">Navigation</p>
        <nav class="mobile-site-navigation" aria-label="{{ locale == 'fr' ? 'Navigation mobile' : 'Mobile navigation' }}">
            {% include '_site-navigation-links.twig' %}
        </nav>
        {% block mobile_navigation %}{% endblock %}
    </aside>

    <main>{% block content %}{% endblock %}</main>

    <footer class="site-footer">
        <span>
            <a href="https://github.com/Matanek/Silex">{{ locale == 'fr' ? 'Langage Silex' : 'Silex language' }}</a>
            {{ locale == 'fr' ? 'développé par' : 'developed by' }}
            <a href="https://github.com/Matanek">Matanek</a>.
        </span>
        <a href="https://github.com/Matanek/Silex/blob/main/LICENSE">Apache-2.0 with LLVM exception</a>
    </footer>
    <script src="/assets/navigation.js" defer></script>
    {% block scripts %}{% endblock %}
</body>
</html>
