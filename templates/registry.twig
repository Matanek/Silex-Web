{% extends 'layout.twig' %}

{% block title %}Silex Registry — {{ locale == 'fr' ? 'Construisez. Publiez. Partagez.' : 'Build. Release. Share.' }}{% endblock %}
{% block description %}{{ locale == 'fr' ? 'Découvrez le registre public des packages Silex et apprenez à publier votre package.' : 'Discover the public Silex package registry and learn how to publish your package.' }}{% endblock %}
{% block body_class %}registry-page{% endblock %}

{% block content %}
<section class="registry-hero-section" aria-labelledby="registry-title">
<div class="section-container registry-hero">
    <div class="registry-hero-copy">
        <p class="eyebrow">{{ locale == 'fr' ? 'Registre public de packages · v1' : 'Public package registry · v1' }}</p>
        <h1 id="registry-title">{{ locale == 'fr' ? 'Construisez' : 'Build it' }}<br><span>{{ locale == 'fr' ? 'Publiez' : 'Release it' }}</span><br>{{ locale == 'fr' ? 'Partagez' : 'Share it' }}</h1>
        <p class="lede">{{ locale == 'fr' ? 'Silex grandit grâce aux logiciels qui fonctionnent. Améliorez le langage, renforcez ses packages ou publiez une capacité réutilisable.' : 'Silex grows through working software. Improve the language, strengthen its packages, or publish a reusable capability.' }}</p>
        <div class="actions">
            <a class="button button-primary" href="#publish">{{ locale == 'fr' ? 'Enregistrer un package' : 'Register a package' }}</a>
            <a class="button button-secondary" href="https://github.com/Matanek/Silex-Registry/pulls">{{ locale == 'fr' ? 'Suivre les inscriptions' : 'Track registrations' }}</a>
        </div>
    </div>

    <aside class="registry-card" aria-labelledby="registry-card-title">
        <div class="registry-card-titlebar">
            <span class="status-dot" aria-hidden="true"></span>
            <strong id="registry-card-title">registry.silex-lang.org</strong>
            <span>API</span>
        </div>
        <dl class="registry-facts">
            <div><dt>Format</dt><dd>Static JSON</dd></div>
            <div><dt>{{ locale == 'fr' ? 'Contrat' : 'Contract' }}</dt><dd>{{ locale == 'fr' ? 'Nom → dépôt Git' : 'Name → Git repository' }}</dd></div>
            <div><dt>Versions</dt><dd>{{ locale == 'fr' ? 'Tags du dépôt' : 'Repository tags' }}</dd></div>
        </dl>
        <a class="registry-endpoint" href="https://registry.silex-lang.org/v1/index.json">
            <span>GET</span><code>/v1/index.json</code><b aria-hidden="true">→</b>
        </a>
    </aside>
</div>
</section>

<section class="registry-section registry-contribute-section" id="contribute" aria-labelledby="contribute-title">
<div class="section-container">
    <div class="registry-heading registry-heading-split">
        <div><p class="eyebrow section-tag">{{ locale == 'fr' ? 'Choisissez votre contribution' : 'Choose your contribution' }}</p><h2 id="contribute-title">{{ locale == 'fr' ? 'Faites avancer Silex' : 'Move Silex forward' }}</h2></div>
        <p>{{ locale == 'fr' ? 'Partez d’un besoin concret. Une correction ciblée, un exemple lisible ou un petit package peut améliorer toute l’expérience de développement.' : 'Start from a concrete need. A focused fix, a readable example, or a small package can improve the whole developer experience.' }}</p>
    </div>

    {% set contributions = locale == 'fr' ? [
        ['01', 'Langage et toolchain', 'Améliorez les diagnostics, la sémantique, la compilation native, les outils ou les exemples qui prouvent une fonctionnalité.', 'Explorer Silex', 'https://github.com/Matanek/Silex'],
        ['02', 'Packages officiels', 'Renforcez la bibliothèque standard ou la pile applicative GFX avec des API publiques orientées intention.', 'Explorer les packages', '/' ~ locale ~ '/#packages'],
        ['03', 'Packages communautaires', 'Regroupez une capacité utile, inscrivez son dépôt une fois, puis laissez le registre suivre ses tags Git.', 'Voir le parcours', '#publish']
    ] : [
        ['01', 'Language & toolchain', 'Improve diagnostics, semantics, native compilation, tooling, or the examples that prove a feature works.', 'Explore Silex', 'https://github.com/Matanek/Silex'],
        ['02', 'Official packages', 'Strengthen the standard library or the GFX application stack through intention-oriented public APIs.', 'Explore packages', '/' ~ locale ~ '/#packages'],
        ['03', 'Community packages', 'Package one useful capability, register its repository once, then let the registry follow its Git tags.', 'Read the release path', '#publish']
    ] %}
    <div class="contribution-grid">
        {% for contribution in contributions %}
            <article class="contribution-card">
                <span class="card-number">{{ contribution[0] }}</span>
                <h3>{{ contribution[1] }}</h3>
                <p>{{ contribution[2] }}</p>
                <a href="{{ contribution[4] }}">{{ contribution[3] }} <span aria-hidden="true">→</span></a>
            </article>
        {% endfor %}
    </div>
</div>
</section>

<section class="registry-section registry-publish-section" id="publish" aria-labelledby="publish-title">
<div class="section-container">
    <div class="registry-heading registry-heading-split publish-heading">
        <div><p class="eyebrow section-tag">{{ locale == 'fr' ? 'Enregistrer un package' : 'Register a package' }}</p><h2 id="publish-title">{{ locale == 'fr' ? 'Enregistrez votre package' : 'Register your package' }}</h2></div>
        <p>{% if locale == 'fr' %}La commande <code>silex register</code> ouvre l’unique proposition d’inscription du package. Une fois acceptée, le registre lit les versions dans les tags Git du dépôt : aucune nouvelle commande Silex ni pull request n’est nécessaire.{% else %}<code>silex register</code> opens the package’s single registry proposal. Once accepted, the registry reads releases from the repository’s Git tags: no new Silex command or pull request is required.{% endif %}</p>
    </div>

    {% set steps = locale == 'fr' ? [
        ['01', 'Préparer le package', 'Définissez la version sémantique et la compatibilité Silex, puis commitez le contenu complet du package.', null, null],
        ['02', 'Vérifier si nécessaire', 'Lancez', 'silex check chemin/du/Package', ' pour valider sans modification son contrat et le tag attendu.'],
        ['03', 'Enregistrer le package', 'Lancez une seule fois', 'silex register chemin/du/Package', '. Silex propose le nom du package et son dépôt canonique au registre.'],
        ['04', 'Créer un tag de version', 'Créez et poussez le tag', 'vMAJOR.MINOR.PATCH', ' correspondant. Aucune nouvelle pull request au registre n’est nécessaire.']
    ] : [
        ['01', 'Prepare the package', 'Set the semantic version and Silex compatibility, then commit the package’s complete contents.', null, null],
        ['02', 'Check when useful', 'Run', 'silex check path/to/Package', ' to validate its contract and expected tag without changing anything.'],
        ['03', 'Register the package', 'Run once', 'silex register path/to/Package', '. Silex proposes the package name and canonical repository to the registry.'],
        ['04', 'Create a version tag', 'Create and push the matching', 'vMAJOR.MINOR.PATCH', ' tag. No additional registry pull request is required.']
    ] %}
    <div class="publish-layout">
        <ol class="release-steps">
            {% for step in steps %}
                <li>
                    <span>{{ step[0] }}</span>
                    <div><h3>{{ step[1] }}</h3><p>{{ step[2] }}{% if step[3] %} <code>{{ step[3] }}</code>{% endif %}{% if step[4] %}{{ step[4] }}{% endif %}</p></div>
                </li>
            {% endfor %}
        </ol>

        <div class="manifest-window" aria-label="{{ locale == 'fr' ? 'Enregistrer un package avec la ligne de commande Silex' : 'Register a package with the Silex command line' }}">
            <div class="registry-card-titlebar"><span class="file-mark" aria-hidden="true">$</span><strong>Example 1.0.0</strong></div>
            <pre><code><span class="key">$</span> silex check Packages/Example
<span class="value">silex: package Example@1.0.0 is valid;
its release tag is v1.0.0</span>

<span class="key">$</span> silex register Packages/Example

<span class="value">silex: submitted registration of Example
for registry review</span>

<span class="key">$</span> git tag v1.0.0
<span class="key">$</span> git push origin v1.0.0</code></pre>
            <a href="https://github.com/Matanek/Silex-Registry/blob/main/CONTRIBUTING.md">{{ locale == 'fr' ? 'Lire le contrat d’inscription' : 'Read the registration contract' }} <span aria-hidden="true">→</span></a>
        </div>
    </div>

    <aside class="registry-review" aria-labelledby="registry-review-title">
        <div class="registry-review-copy">
            <h3 class="eyebrow" id="registry-review-title">{{ locale == 'fr' ? 'Suivi des inscriptions' : 'Registration tracking' }}</h3>
            <p>{% if locale == 'fr' %}<code>silex register</code> ouvre une pull request. Consultez-la pour vérifier son statut et les éventuels retours de revue.{% else %}<code>silex register</code> opens a pull request. Check it to follow its status and any review feedback.{% endif %}</p>
        </div>
        <a class="button button-secondary" href="https://github.com/Matanek/Silex-Registry/pulls">{{ locale == 'fr' ? 'Voir les pull requests' : 'View pull requests' }}</a>
    </aside>
</div>
</section>
{% endblock %}
