{% extends 'layout.twig' %}

{% block title %}{{ locale == 'fr' ? 'Packages Silex' : 'Silex Packages' }}{% endblock %}

{% block description %}{{ locale == 'fr' ? 'Découvrez les packages Silex et leur documentation canonique.' : 'Discover Silex packages and their canonical documentation.' }}{% endblock %}

{% block content %}
<section class="packages-index" aria-labelledby="packages-index-title">
    <div class="packages-index-heading">
        <p class="eyebrow">{{ locale == 'fr' ? 'Écosystème Silex' : 'Silex ecosystem' }} · {{ silex_version == 'development' ? 'dev' : 'v' ~ silex_version }}</p>
        <h1 id="packages-index-title">{{ locale == 'fr' ? 'Packages et documentation.' : 'Packages and documentation.' }}</h1>
        <p>
            {{ locale == 'fr'
                ? 'Le catalogue lit directement les manifests et les documentations anglaises possédés par chaque package.'
                : 'The catalog reads the manifests and English documentation owned directly by each package.' }}
        </p>
    </div>

    {% if packages is empty %}
        <p class="content-unavailable">{{ locale == 'fr' ? 'Aucune source de packages n’est connectée.' : 'No package source is connected.' }}</p>
    {% else %}
        <div class="package-catalog" data-package-count="{{ packages|length }}">
            {% for package in packages %}
                <a class="package-catalog-card" href="/{{ locale }}/packages/{{ package.name|url_encode }}">
                    <div class="package-catalog-meta">
                        <strong>{{ package.name }}</strong>
                        {% if package.version %}<span>v{{ package.version }}</span>{% endif %}
                    </div>
                    <p>{{ package.description ?: (locale == 'fr' ? 'Package Silex.' : 'Silex package.') }}</p>
                    <div class="package-catalog-footer">
                        <span>{{ package.document_count }} pages</span>
                        <b aria-hidden="true">→</b>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
