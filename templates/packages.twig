{% extends 'layout.twig' %}

{% block title %}{{ locale == 'fr' ? 'Packages Silex' : 'Silex Packages' }}{% endblock %}
{% block description %}{{ locale == 'fr' ? 'Découvrez les packages Silex inscrits au registre.' : 'Discover Silex packages registered in the public registry.' }}{% endblock %}

{% block content %}
<section class="packages-index" aria-labelledby="packages-index-title">
    <div class="packages-index-heading">
        <p class="eyebrow">{{ locale == 'fr' ? 'Écosystème Silex' : 'Silex ecosystem' }} · {{ silex_version == 'development' ? 'dev' : 'v' ~ silex_version }}</p>
        <h1 id="packages-index-title">{{ locale == 'fr' ? 'Packages enregistrés.' : 'Registered packages.' }}</h1>
        <p>{{ locale == 'fr' ? 'Chaque entrée renvoie vers le dépôt canonique du package. Sa documentation et ses versions restent sous la responsabilité de son auteur.' : 'Each entry links to the package’s canonical repository. Its author remains responsible for its documentation and releases.' }}</p>
    </div>

    {% if packages is empty %}
        <p class="content-unavailable">{{ locale == 'fr' ? 'Aucun registre de packages n’est connecté.' : 'No package registry is connected.' }}</p>
    {% else %}
        <div class="package-catalog" data-package-count="{{ packages|length }}">
            {% for package in packages %}
                {% include '_package-card.twig' with {package: package, locale: locale} only %}
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
