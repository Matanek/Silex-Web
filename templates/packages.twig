{% extends 'layout.twig' %}

{% block title %}Silex Packages{% endblock %}
{% block description %}Discover Silex packages and their canonical documentation.{% endblock %}

{% block content %}
<section class="packages-index" aria-labelledby="packages-index-title">
    <div class="packages-index-heading">
        <p class="eyebrow">Silex ecosystem · {{ silex_version == 'development' ? 'dev' : 'v' ~ silex_version }}</p>
        <h1 id="packages-index-title">Packages and documentation.</h1>
        <p>The catalog reads the manifests and English documentation owned directly by each package.</p>
    </div>

    {% if packages is empty %}
        <p class="content-unavailable">No package source is connected.</p>
    {% else %}
        <div class="package-catalog" data-package-count="{{ packages|length }}">
            {% for package in packages %}
                {% include '_package-card.twig' with {package: package} only %}
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
